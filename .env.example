# Local development template: copy to .env.local. See docs/operations.md.
# Uncomment optional settings only when enabling the corresponding feature.
# For settings managed by the Settings page, database overrides take precedence.
# Replace the auth secret and administrator email before first use.
# Database and S3 credentials below match compose.yaml and are for local use only.

# --- Bootstrap: database ---
DATABASE_URL=postgresql://agent_memory:agent_memory@localhost:5433/agent_memory

# --- Knowledge graph: Neo4j (required; matches the local Compose service) ---
# These process-level credentials are not editable from the Settings page.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=agent_memory_dev
NEO4J_DATABASE=neo4j

# --- Authentication and access policy ---
# Use a random secret of at least 32 characters; it also encrypts stored secrets.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3100
# Enable at least one login method before starting: password, Google, or OIDC.
# Local signup: set both password flags to true. Public production signup is forbidden.
AUTH_PASSWORD=false
AUTH_PASSWORD_SIGNUP=false
# Empty or unset allows every email domain.
ALLOWED_EMAIL_DOMAINS=
# Comma-separated administrator emails; replace with your actual account.
ADMIN_EMAILS=me@nalbam.com

# Google OAuth (optional; configure both values)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OIDC (optional; configure issuer, client ID, and client secret together)
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile

# --- Documents: worker and quotas ---
# Worker processes queued uploads; false leaves them pending. Runtime default: false.
DOCUMENT_WORKER_ENABLED=true
# Positive integers: organization storage bytes (1 GiB), pending/processing count,
# and uploads per user per hour.
DOCUMENT_STORAGE_QUOTA_BYTES=1073741824
DOCUMENT_PENDING_QUOTA=100
DOCUMENT_UPLOADS_PER_USER_PER_HOUR=100

# --- Object storage: S3 / local MinIO ---
S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-northeast-2
S3_BUCKET=agent-memory
S3_ACCESS_KEY_ID=agent_memory
S3_SECRET_ACCESS_KEY=agent_memory_dev
S3_FORCE_PATH_STYLE=true

# --- AI: embedding (optional) ---
# Set model and base URL to enable semantic search; otherwise use lexical search.
# API key is optional for an unauthenticated local endpoint.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small

# --- AI: reranker (optional) ---
# Set base URL and model together. API key is optional.
# RERANKER_BASE_URL=https://openrouter.ai/api/v1
# RERANKER_API_KEY=
# RERANKER_MODEL=voyageai/rerank-2.5-lite
# Timeout: positive integer milliseconds. Minimum score: optional number from 0 to 1.
# RERANKER_TIMEOUT_MS=5000
# RERANKER_MIN_SCORE=

# --- AI: knowledge extraction, verification, and ontology suggestions (optional) ---
# Each non-empty extraction receives a separate verification call using this model.
# Explicit, useful, grounded facts are auto-accepted; uncertain facts need human review.
# Set model and base URL; the model must support JSON Schema structured output.
# API key is optional for an unauthenticated local endpoint.
KNOWLEDGE_EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
# KNOWLEDGE_EXTRACTION_API_KEY=
# KNOWLEDGE_EXTRACTION_MODEL=provider/structured-output-model
# Human-readable output: source (document language), ko (Korean), en (English).
# Source names and evidence retain their original spelling and script.
KNOWLEDGE_EXTRACTION_LANGUAGE=ko
# Parallel enrichment jobs (1-16), capped by AI_PROVIDER_MAX_CONCURRENCY.
KNOWLEDGE_ENRICHMENT_CONCURRENCY=4

# --- AI: request limits (positive integers) ---
# Shared across AI features within each application instance.
AI_PROVIDER_MAX_CONCURRENCY=8
AI_PROVIDER_REQUESTS_PER_MINUTE=120
# Durable quotas shared across instances through PostgreSQL.
AI_ORGANIZATION_REQUESTS_PER_MINUTE=120
AI_USER_REQUESTS_PER_MINUTE=30

# --- Observability: logging ---
LOG_LEVEL=info

# Prometheus metrics (optional; unset disables the endpoint)
# METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Langfuse tracing (optional; configure both keys together)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Export mode: batched or immediate; defaults to immediate on Vercel, batched elsewhere.
# LANGFUSE_EXPORT_MODE=batched
# LANGFUSE_TRACING_ENVIRONMENT=development

# --- Development / build (optional) ---
# Custom Next.js output directory; Playwright sets .next-e2e for its server.
# NEXT_DIST_DIR=.next
# NODE_ENV is selected by Next.js commands; Docker sets production.
# Docker also sets PORT=3000, HOSTNAME=0.0.0.0, NEXT_MANUAL_SIG_HANDLE=true.
# Supply these through the process/container environment when customizing the runner.
# NEXT_RUNTIME, NEXT_PHASE, VERCEL, and CI are supplied by their respective runtimes.
# E2E_AUTHENTICATED and E2E_RUN_ID belong to the test runner, not .env.local;
# see docs/operations.md for the disposable test database and E2E commands.
