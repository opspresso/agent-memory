# Database
DATABASE_URL=postgresql://agent_memory:agent_memory@localhost:5433/agent_memory

# Runtime
MIGRATE_ON_START=false
DOCUMENT_WORKER_ENABLED=true

# Authentication
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3100
AUTH_PASSWORD=false
AUTH_PASSWORD_SIGNUP=false
ALLOWED_EMAIL_DOMAINS=nalbam.com
ADMIN_EMAILS=me@nalbam.com

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OIDC
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile

# Embedding
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Knowledge extraction
KNOWLEDGE_EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
# KNOWLEDGE_EXTRACTION_API_KEY=
# KNOWLEDGE_EXTRACTION_MODEL=provider/structured-output-model

# Object storage
S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-northeast-2
S3_BUCKET=agent-memory
S3_ACCESS_KEY_ID=agent_memory
S3_SECRET_ACCESS_KEY=agent_memory_dev
S3_FORCE_PATH_STYLE=true

# Logging and telemetry
LOG_LEVEL=info
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_EXPORT_MODE=batched
# LANGFUSE_TRACING_ENVIRONMENT=development
