# `.env.aws`로 복사하고 SSM Parameter Store를 읽을 최소 권한의 credential을 넣는다.
# deploy script는 다음 경로만 복호화해 `.env.runtime-secrets`를 생성한다.
#
# /k8s/common/agent-memory/google-client-id
# /k8s/common/agent-memory/google-client-secret
# /k8s/common/agent-memory/embedding-api-key
# /k8s/common/agent-memory/knowledge-extraction-api-key

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
