AGENT_MEMORY_IMAGE=ghcr.io/opspresso/agent-memory:latest
BETTER_AUTH_URL=https://memory.opspresso.com
ADMIN_EMAILS=me@nalbam.com
ALLOWED_EMAIL_DOMAINS=nalbam.com
AUTH_PASSWORD=false
AUTH_PASSWORD_SIGNUP=false
LOG_LEVEL=info

# Optional OpenAI-compatible providers
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
KNOWLEDGE_EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
KNOWLEDGE_EXTRACTION_MODEL=openai/gpt-5.6-luna
